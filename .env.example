# =============================================================================
# SGCM - Variables d'environnement
#
# Copie ce fichier en `.env` à la racine du projet et remplace les valeurs.
# NE PAS commiter le fichier `.env` (ajoute-le à .gitignore).
# =============================================================================

# --- Base de données PostgreSQL ---------------------------------------------
DB_PASSWORD=change_me_pg_password_strong

# --- Authentification JWT ---------------------------------------------------
# Génère un secret long et aléatoire :
#   openssl rand -base64 48
JWT_SECRET=change_me_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=1h

# --- Chiffrement des données médicales & sensibles --------------------------
# Clé AES-256 (32 octets) - génère-la avec :
#   openssl rand -hex 32
ENCRYPTION_KEY=change_me_64_hex_chars

# --- Brevo (e-mails transactionnels : confirmation compte, rappels RDV) -----
# Récupère ta clé sur https://app.brevo.com/settings/keys/api
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
MAIL_FROM=no-reply@cabinet-medical.local

# --- Google ReCaptcha (anti-spam sur formulaires publics) -------------------
# Crée tes clés sur https://www.google.com/recaptcha/admin
RECAPTCHA_SITE_KEY=6Lxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RECAPTCHA_SECRET=6Lxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Token interne pour le scheduler (auth des appels cron -> API) ----------
SCHEDULER_TOKEN=change_me_internal_scheduler_token
